-- Efek blinking layar selama 30 detik
local startTime = tick()
local blinkTime = 30

local blinking = RunService.RenderStepped:Connect(function()
	local elapsed = tick() - startTime
	if elapsed > blinkTime then
		blinking:Disconnect()
		screenGui:Destroy()
		return
	end

	local t = math.floor(elapsed * 5) % 2
	frame.BackgroundColor3 = (t == 0) and Color3.new(1, 1, 1) or Color3.new(0, 0, 0)
end)
